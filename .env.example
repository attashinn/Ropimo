# Public Domain & App Configuration
NEXT_PUBLIC_SITE_URL=https://zambic.com
NEXT_PUBLIC_APP_URL=https://app.zambic.com

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-dark-forest-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-dark-forest-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase Compatibility / Local Emulation Keys
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secrets (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudflare R2 Storage (documents, logos, avatars, attachments)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_BUCKET_NAME=zambic
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare Workers AI (AI Copilot, resume parsing, quick-create)
CLOUDFLARE_AI_TOKEN=your-cloudflare-ai-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# OpenRouter AI (Fallback or primary LLM gateway for Llama 3.3, Claude, GPT-4o, DeepSeek)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ElevenLabs (Text-to-Speech & Voice Synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-sk-api-key

# Neon Auth (Hosted Better Auth on Neon for Google OAuth & Email Auth)
NEON_AUTH_URL=https://ep-dark-forest-pooler.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-dark-forest-pooler.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-dark-forest-pooler.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Resend Email Delivery
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Zambic <notifications@app.zambic.com>
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# Cloudflare Turnstile CAPTCHA (Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Automation & Background Jobs
CRON_SECRET=your_random_secure_cron_secret
